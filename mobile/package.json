{
  "name": "atp-mobile",
  "version": "0.1.0",
  "description": "At The Park — Mobile App (React Native + Expo). Connects to the same backend as atthepark.world.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:ios:dev": "eas build -p ios --profile development",
    "build:ios:prod": "eas build -p ios --profile production",
    "build:android:dev": "eas build -p android --profile development",
    "build:android:prod": "eas build -p android --profile production",
    "submit:ios": "eas submit -p ios --latest",
    "submit:android": "eas submit -p android --latest"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.4.10",
    "@expo-google-fonts/barlow-condensed": "^0.2.3",
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@tanstack/react-query": "^5.51.23",
    "expo": "^57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.5",
    "expo-brightness": "~57.0.1",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.0.36",
    "onesignal-expo-plugin": "2.0.3",
    "promise": "^8.3.0",
    "react": "19.2.3",
    "react-hook-form": "^7.52.2",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-onesignal": "5.2.6",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
