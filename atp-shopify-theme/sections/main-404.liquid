<section class="page-404">
  <p class="code">{{ section.settings.code | default: '404' }}</p>
  <h1 class="h2" style="margin-top:10px">{{ section.settings.heading | default: 'general.404_title' | t }}</h1>
  <p style="color:var(--muted);margin-top:12px">{{ section.settings.text | default: 'general.404_text' | t }}</p>
  {%- if section.settings.cta_label != blank -%}
    <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top:26px">
      {{ section.settings.cta_label }} {% render 'icon-arrow' %}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "code", "label": "Big number", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "That page has moved or never existed. The kit is still here." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to link to all products." }
  ]
}
{% endschema %}
